{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "schedule:weekly"
  ],
  "schedule": [
    "before 3am on Monday"
  ],
  "semanticCommits": "enabled",
  "commitMessagePrefix": "chore(deps): ",
  "commitMessageAction": "update",
  "commitMessageTopic": "{{{depName}}}",
  "prConcurrentLimit": 10,
  "prCreation": "not-pending",
  "minimumReleaseAge": "3 days",
  "labels": [
    "dependencies",
    "renovate"
  ],
  "ignorePaths": [
    "node_modules/**",
    ".venv/**",
    "venv/**"
  ],
  "helm": {
    "enabled": true
  },
  "helmv3": {
    "enabled": true
  },
  "kubernetes": {
    "enabled": true,
    "managerFilePatterns": [
      "/^apps/.+\\.ya?ml$/",
      "/^clusters/.+\\.ya?ml$/"
    ]
  },
  "packageRules": [
    {
      "description": "Automatically rebase Renovate's PRs when there are conflicts",
      "matchUpdateTypes": [
        "minor",
        "patch",
        "digest",
        "lockFileMaintenance"
      ],
      "rebaseWhen": "behind-base-branch"
    },
    {
      "description": "Group all non-major updates",
      "matchUpdateTypes": [
        "minor",
        "patch",
        "digest"
      ],
      "groupName": "non-major updates",
      "groupSlug": "non-major-updates"
    }
  ]
}
